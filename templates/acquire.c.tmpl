#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#ifdef WIN32
#include "windows.h"
#include "ps2000.h"
#define PREF4 _stdcall
#else
#include <unistd.h>
#include "libps2000/ps2000.h"
