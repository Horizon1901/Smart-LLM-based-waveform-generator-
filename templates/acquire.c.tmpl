        printf("\nSaved full capture -> acquisition_{{GEN_ID}}.csv\n");
    }

    /* 9. Summary line parsed by the executor for spoken feedback. */
    printf("RESULT: acquired %d samples from {{CHANNEL_DESC}}, overflow=%d\n",
           n_returned, overflow);

    ps2000_close_unit(handle);
    return 0;
}
