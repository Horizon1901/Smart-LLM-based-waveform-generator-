        Sleep(10);
        waited_ms += 10;
        if (waited_ms > READY_TIMEOUT_MS)
        {
            printf("ERROR: capture did not complete within %d ms\n", READY_TIMEOUT_MS);
            ps2000_stop(handle);
            ps2000_close_unit(handle);
            return 96;
        }
    }
    ps2000_stop(handle);

    /* 6. Retrieve samples (manufacturer: ps2000_get_times_and_values). */
