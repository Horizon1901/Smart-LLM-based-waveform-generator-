                                             NULL, NULL, &overflow, time_units,
                                             no_of_samples);
    if (n_returned <= 0)
    {
        printf("ERROR: ps2000_get_times_and_values returned no data\n");
        ps2000_close_unit(handle);
        return 95;
    }

    /* 7. Report first samples of every enabled channel, in mV. */
{{PRINT_BLOCK}}

    /* 8. Persist full capture to CSV. A disabled channel is written as 0 so the
     *    column layout stays stable regardless of which channel was requested. */
    fp = fopen("acquisition_{{GEN_ID}}.csv", "w");
    if (fp)
    {
        fprintf(fp, "sample,time_ns,chA_adc,chA_mv,chB_adc,chB_mv\n");
        for (i = 0; i < n_returned; i++)
        {
            fprintf(fp, "%d,%d,%d,%d,%d,%d\n", i, times[i],
                    chA_on ? values_a[i] : 0,
                    chA_on ? adc_to_mv(values_a[i], {{RANGE_A_INDEX}}) : 0,
                    chB_on ? values_b[i] : 0,
                    chB_on ? adc_to_mv(values_b[i], {{RANGE_B_INDEX}}) : 0);
