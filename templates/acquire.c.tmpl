#define Sleep(a) usleep(1000 * (a))
#endif

/* Open resilience (covers the first-open firmware re-enumeration window). */
#define OPEN_MAX_TRIES   20
#define OPEN_RETRY_MS    250
/* Upper bound for the timebase search (PS2200 family max == host-side clamp). */
#define MAX_TIMEBASE     PS2200_MAX_TIMEBASE
/* Give up waiting for a block instead of hanging forever. */
#define READY_TIMEOUT_MS 5000

/* Input ranges in mV, indexed by PS2000_RANGE -- identical to manufacturer. */
static int32_t input_ranges[PS2000_MAX_RANGES] =
    {10, 20, 50, 100, 200, 500, 1000, 2000, 5000, 10000, 20000, 50000};

/* adc_to_mv / mv_to_adc -- copied from the manufacturer example verbatim. */
static int32_t adc_to_mv(int32_t raw, int32_t ch) { return (raw * input_ranges[ch]) / 32767; }
static int16_t mv_to_adc(int16_t mv,  int16_t ch) { return (int16_t)((mv * 32767) / input_ranges[ch]); }

int main(void)
{
    int16_t  handle = 0;
    int8_t   info[80];
    int32_t  time_interval = 0;
    int16_t  time_units = 0;
    int16_t  oversample   = {{OVERSAMPLE}};
    int32_t  no_of_samples = {{N_SAMPLES}};
    int32_t  max_samples = 0;
    int32_t  time_indisposed_ms = 0;
    int16_t  overflow = 0;
    int16_t  timebase = {{TIMEBASE}};
    int16_t  tb;
    int32_t  n_returned;
    int32_t  waited_ms;
    int      found;
    int      open_try;
    int      chA_on = {{CH_A_ENABLED}};
    int      chB_on = {{CH_B_ENABLED}};
    int32_t  i;
    FILE    *fp;

    /* Static buffers sized for the sample count. */
    static int32_t times[{{N_SAMPLES}}];
    static int16_t values_a[{{N_SAMPLES}}];
    static int16_t values_b[{{N_SAMPLES}}];

    (void)mv_to_adc;  /* kept for manufacturer parity; threshold is precomputed */

    printf("== PicoWave acquisition {{GEN_ID}} ==\n");

    /* 1. Open the device, retrying across the firmware-load re-enumeration.
     *    A device that is briefly re-enumerating on first open returns 0/-1;
     *    a later try picks it up once it re-appears (manufacturer: ps2000_open_unit). */
    for (open_try = 1; open_try <= OPEN_MAX_TRIES; open_try++)
    {
        handle = ps2000_open_unit();
        if (handle > 0)
            break;
        printf("Device not ready (attempt %d/%d), waiting for enumeration...\n",
               open_try, OPEN_MAX_TRIES);
        Sleep(OPEN_RETRY_MS);
    }
    if (handle <= 0)
    {
        printf("ERROR: unable to open PicoScope device\n");
        return 99;
    }
    ps2000_get_unit_info(handle, info, sizeof(info), 3);
    printf("Device variant: %s\n", (char *)info);

    /* 2. Enable ONLY the requested channel so it gets the whole block buffer
     *    (manufacturer: ps2000_set_channel per channel). */
    ps2000_set_channel(handle, PS2000_CHANNEL_A, {{CH_A_ENABLED}}, {{DC_COUPLED}}, {{RANGE_A_ENUM}});
    ps2000_set_channel(handle, PS2000_CHANNEL_B, {{CH_B_ENABLED}}, {{DC_COUPLED}}, {{RANGE_B_ENUM}});

    /* 3. Trigger (manufacturer: ps2000_set_trigger). */
{{TRIGGER_BLOCK}}

    /* 4. Resolve a timebase that is valid AND large enough for the request.
     *    The manufacturer loops "timebase++" on get_timebase forever; here the
     *    loop is bounded and the returned max_samples is actually checked. */
    found = 0;
    for (tb = timebase; tb <= MAX_TIMEBASE; tb++)
    {
        if (ps2000_get_timebase(handle, tb, no_of_samples, &time_interval,
                                &time_units, oversample, &max_samples))
        {
            if (no_of_samples <= max_samples)
            {
                timebase = tb;
                found = 1;
                break;
            }
        }
    }
    if (!found)
    {
        printf("ERROR: no timebase fits %d samples in this channel configuration "
               "(device max %d samples)\n", no_of_samples, max_samples);
        ps2000_close_unit(handle);
        return 98;
    }
    printf("Timebase %d -> %d ns/sample, %d samples (device max %d)\n",
           timebase, time_interval, no_of_samples, max_samples);

    /* 5. Run one block and wait (manufacturer: run_block / ready / stop). */
    if (!ps2000_run_block(handle, no_of_samples, timebase, oversample,
                          &time_indisposed_ms))
    {
        printf("ERROR: ps2000_run_block was rejected by the driver\n");
        ps2000_stop(handle);
        ps2000_close_unit(handle);
        return 97;
    }
    waited_ms = 0;
    while (!ps2000_ready(handle))
